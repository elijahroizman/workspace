{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workspace",
  "version": "0.6.0",
  "identifier": "com.eliroizman.workspace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Workspace",
        "width": 1320,
        "height": 860,
        "minWidth": 720,
        "minHeight": 460,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 20
        },
        "backgroundColor": "#161616",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' wsplugin: http://wsplugin.localhost",
        "style-src": "'self' 'unsafe-inline' wsplugin: http://wsplugin.localhost",
        "img-src": "'self' data: blob: https://i.ytimg.com wsplugin: http://wsplugin.localhost",
        "font-src": "'self' data: blob: wsplugin: http://wsplugin.localhost",
        "media-src": "'self' data: blob:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob: wsplugin: http://wsplugin.localhost",
        "frame-src": "https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com",
        "object-src": "'none'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Word, PowerPoint, PDF, Markdown and text files in one tabbed window",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "docx"
        ],
        "name": "Word Document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      },
      {
        "ext": [
          "pptx"
        ],
        "name": "PowerPoint Presentation",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF Document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/pdf"
      },
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/markdown"
      },
      {
        "ext": [
          "txt"
        ],
        "name": "Plain Text Document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "excalidraw"
        ],
        "name": "Excalidraw Drawing",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/vnd.excalidraw+json",
        "exportedType": {
          "identifier": "com.eliroizman.workspace.excalidraw",
          "conformsTo": [
            "public.json"
          ]
        }
      },
      {
        "ext": [
          "epub"
        ],
        "name": "EPUB Book",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/epub+zip"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBBNzUxMjYwNUZGMEI4QTAKUldTZ3VQQmZZQkoxQ3ZKMm41ZHBtenYxV1ErcnE4UjgzMUJOYzlEMHRySldZdGFLcnh3UFpMQjIK",
      "endpoints": [
        "https://github.com/elijahroizman/workspace/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
