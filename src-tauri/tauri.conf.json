{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Writan",
  "mainBinaryName": "writan",
  "version": "0.10.4",
  "identifier": "com.eliroizman.workspace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Writan",
        "width": 1320,
        "height": 860,
        "minWidth": 720,
        "minHeight": 460,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 24
        },
        "backgroundColor": "#161616",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' wsplugin: http://wsplugin.localhost",
        "style-src": "'self' 'unsafe-inline' wsplugin: http://wsplugin.localhost",
        "img-src": "'self' data: blob: https://i.ytimg.com wsplugin: http://wsplugin.localhost",
        "font-src": "'self' data: blob: wsplugin: http://wsplugin.localhost",
        "media-src": "'self' data: blob:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob: wsplugin: http://wsplugin.localhost",
        "frame-src": "https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com",
        "object-src": "'none'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Word, PowerPoint, Excel, PDF, Markdown and text files in one tabbed window",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "docx"
        ],
        "name": "Word Document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      },
      {
        "ext": [
          "pptx"
        ],
        "name": "PowerPoint Presentation",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation"
      },
      {
        "ext": [
          "xlsx"
        ],
        "name": "Excel Workbook",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      },
      {
        "ext": [
          "csv"
        ],
        "name": "CSV File",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/csv"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF Document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/pdf"
      },
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/markdown"
      },
      {
        "ext": [
          "txt"
        ],
        "name": "Plain Text Document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "tex"
        ],
        "name": "LaTeX Document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/x-tex"
      },
      {
        "ext": [
          "png"
        ],
        "name": "PNG Image",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "image/png"
      },
      {
        "ext": [
          "jpg",
          "jpeg"
        ],
        "name": "JPEG Image",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "image/jpeg"
      },
      {
        "ext": [
          "heic",
          "heif"
        ],
        "name": "HEIC Image",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "image/heic"
      },
      {
        "ext": [],
        "contentTypes": [
          "public.folder"
        ],
        "name": "Folder",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "section": "editors",
        "files": {
          "/usr/share/keyrings/workspace-archive-keyring.gpg": "linux/workspace-archive-keyring.gpg"
        },
        "postInstallScript": "linux/postinst",
        "postRemoveScript": "linux/postrm"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ],
        "files": {
          "/etc/pki/rpm-gpg/RPM-GPG-KEY-workspace": "linux/RPM-GPG-KEY-workspace"
        },
        "postInstallScript": "linux/rpm-postinst",
        "postRemoveScript": "linux/rpm-postrm"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBBNzUxMjYwNUZGMEI4QTAKUldTZ3VQQmZZQkoxQ3ZKMm41ZHBtenYxV1ErcnE4UjgzMUJOYzlEMHRySldZdGFLcnh3UFpMQjIK",
      "endpoints": [
        "https://github.com/elijahroizman/workspace/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
