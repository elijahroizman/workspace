#!/bin/sh
# Adds Writan's APT repository, so new versions arrive with the system's other updates
# (Software Updater, apt upgrade) and the app's Update button can install them. The repository is
# the assets of the GitHub release tagged "apt", signed with the key this package installs. Once the
# sources file exists it's left alone, so commenting its line out turns the updates off until
# Writan is removed (postrm deletes the file with the keyring).
set -e

SOURCES=/etc/apt/sources.list.d/workspace.list
KEYRING=/usr/share/keyrings/workspace-archive-keyring.gpg

if [ "$1" = configure ] && [ ! -e "$SOURCES" ] && [ -d /etc/apt/sources.list.d ] && [ -r "$KEYRING" ]; then
  cat > "$SOURCES" <<LIST
# Writan updates (https://github.com/elijahroizman/writan). Put a # before the deb line to stop them.
deb [arch=amd64 signed-by=$KEYRING] https://github.com/elijahroizman/writan/releases/download/apt/ ./
LIST
fi

exit 0
