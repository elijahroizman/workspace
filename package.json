{
  "name": "workspace",
  "private": true,
  "version": "0.9.3",
  "type": "module",
  "scripts": {
    "predev": "node scripts/licenses.mjs && npm run plugins:bundled",
    "dev": "vite",
    "build": "node scripts/licenses.mjs && tsc-rs --noEmit -p . && tsc-rs --noEmit -p plugins && vite build",
    "preview": "vite preview",
    "typecheck": "tsc-rs --noEmit -p . && tsc-rs --noEmit -p plugins",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build --bundles app,dmg",
    "licenses": "node scripts/licenses.mjs",
    "plugin:new": "node scripts/new-plugin.mjs",
    "plugins": "npm run plugins:bundled && vite build --config plugins/latex/vite.config.ts",
    "plugins:bundled": "vite build --config plugins/images/vite.config.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@docx-editor.dev/core": "^2.30.0",
    "@docx-editor.dev/fonts": "^2.30.0",
    "@docx-editor.dev/react": "^2.30.0",
    "@embedpdf/engines": "2.15.1",
    "@embedpdf/models": "2.15.1",
    "@embedpdf/pdfium": "2.15.1",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "fast-xml-parser": "^5.11.2",
    "framer-motion": "^14.2.0",
    "highlight.js": "^11.12.0",
    "i18next": "^26.4.5",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.57.0",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "ooxml-ui": "1.13.0",
    "pptx-react-viewer": "^4.37.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.16",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@codemirror/legacy-modes": "^6.5.5",
    "@tauri-apps/cli": "^2.12.3",
    "@types/dompurify": "^3.0.5",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "libheif-js": "1.23.5",
    "tsc-rs": "^0.7.0",
    "vite": "^8.3.4"
  }
}
